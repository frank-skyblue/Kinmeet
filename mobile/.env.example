# API base, including the /api prefix.
# Physical iPhone: use the LAN address Metro prints in exp://<lan-ip>:8081,
# with port 8080. Example: http://192.168.1.20:8080/api
# localhost on the phone is the phone, and login then fails with Network Error.
# Restart `npm start` after changing this file.
# iOS Simulator: http://localhost:8080/api
# Android emulator: http://10.0.2.2:8080/api
EXPO_PUBLIC_API_URL=http://localhost:8080/api
