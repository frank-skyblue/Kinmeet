{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Backend (Node.js)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--loader", "ts-node/esm"],
      "args": ["${workspaceFolder}/back-end/src/app.ts"],
      "cwd": "${workspaceFolder}/back-end",
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "envFile": "${workspaceFolder}/back-end/.env",
      "env": {
        "NODE_ENV": "development"
      },
      "outFiles": ["${workspaceFolder}/back-end/dist/**/*.js"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/back-end/**",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Backend with Nodemon",
      "runtimeExecutable": "nodemon",
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/back-end",
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      // Load secrets from back-end/.env only — avoid putting FIREBASE_* JSON in the "env" block
      // (the debugger may print the full launch command, including env values).
      "envFile": "${workspaceFolder}/back-end/.env",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "type": "firefox",
      "request": "launch",
      "name": "Debug Frontend (Firefox)",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/front-end",
      "reAttach": true,
      "pathMappings": [
        {
          "url": "http://localhost:5173",
          "path": "${workspaceFolder}/front-end"
        }
      ],
      "skipFiles": ["**/node_modules/**"],
      "preLaunchTask": "Start Frontend Dev Server"
    },
    {
      "type": "firefox",
      "request": "attach",
      "name": "Attach to Firefox",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/front-end",
      "pathMappings": [
        {
          "url": "http://localhost:5173",
          "path": "${workspaceFolder}/front-end"
        }
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Seed Users",
      "runtimeExecutable": "${workspaceFolder}/back-end/node_modules/.bin/ts-node",
      "args": [
        "${workspaceFolder}/back-end/src/scripts/seedUsers.ts",
        "--reset"
      ],
      "cwd": "${workspaceFolder}/back-end",
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "envFile": "${workspaceFolder}/back-end/.env",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "type": "node-terminal",
      "name": "JavaScript Debug Terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Start Mobile (Expo)",
      "command": "npm start",
      "cwd": "${workspaceFolder}/mobile",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8080/api"
      }
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Start Mobile (Android)",
      "command": "npm run android",
      "cwd": "${workspaceFolder}/mobile",
      // The emulator reaches the host machine at 10.0.2.2, not localhost.
      // A physical device needs your computer's LAN address in mobile/.env instead.
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8080/api"
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug Full Stack (Frontend + Backend)",
      "configurations": [
        "Debug Backend with Nodemon",
        "Debug Frontend (Firefox)"
      ],
      "presentation": {
        "hidden": false,
        "group": "Full Stack",
        "order": 1
      },
      "stopAll": true
    },
    {
      "name": "Run Mobile + Backend",
      "configurations": [
        "Debug Backend with Nodemon",
        "Start Mobile (Android)"
      ],
      "presentation": {
        "hidden": false,
        "group": "Mobile",
        "order": 1
      },
      "stopAll": true
    }
  ]
}
