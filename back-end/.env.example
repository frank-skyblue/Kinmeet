PORT=8080
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/kinmeet

# JWT
JWT_SECRET=your_jwt_secret_here

# Cloudinary (https://console.cloudinary.com/settings/api-keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Public SPA URL (no trailing slash). Used for CORS, FCM web push click links, and password-reset links.
WEB_APP_URL=http://localhost:5173

# Shared admin password for /api/admin. Required. At least 15 characters; not blank/whitespace-only.
# The value is used as configured (not trimmed). Do not commit real values.
ADMIN_PASS_KEY=replace_with_15+_admin_password

# Admin session cookie SameSite. Default lax. Use none only after confirming the SPA and API are cross-site.
# ADMIN_COOKIE_SAME_SITE=lax

# Reverse-proxy hop count for req.ip. Default 0 (do not trust proxies). Set only after Preview measurement.
# TRUST_PROXY_HOPS=0

# Optional: FCM / Firebase Admin (pick one; path is recommended for local dev — keeps secrets out of env dumps)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-adminsdk-local.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Transactional email via Resend (https://resend.com/api-keys)
# If absent, email sending is silently skipped.
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM=KinMeet <noreply@kinmeet.ca>
# Set to "true" to send real emails in development (otherwise emails are logged but not sent)
# ENABLE_DEVELOPMENT_EMAIL=false
